# Application configuration. Do not commit a real .env file.
APP_NAME=ASD NLP Screening Support API
APP_VERSION=0.1.0
ENVIRONMENT=development
# Comma-separated origins. Replace with actual Flutter web origins only when needed.
CORS_ORIGINS=http://localhost,http://127.0.0.1
# In development (ENVIRONMENT=development), any http(s)://localhost:<port>
# or http(s)://127.0.0.1:<port> origin is also allowed by default, since
# Flutter's web dev server uses a different port per run. Set this to
# override that regex, or set ENVIRONMENT=production to disable it.
# CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
